# ---- Autenticação do admin (edição) ----
# Senha única de admin. Em dev, se não definir, usa "admin".
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar a sessão (string longa aleatória). Em dev tem fallback.
SESSION_SECRET=gere-uma-string-aleatoria-longa

# ---- Persistência em produção (Vercel) ----
# Se GITHUB_TOKEN e GITHUB_REPO estiverem definidos, a edição faz commit no repo
# (o push dispara o redeploy). Sem eles, grava no disco local (apenas dev).
# Token: fine-grained PAT com permissão "Contents: Read and write" neste repo.
GITHUB_TOKEN=
GITHUB_REPO=LeonardoCSouzaa/wikipig
GITHUB_BRANCH=main
